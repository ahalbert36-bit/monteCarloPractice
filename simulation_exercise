## Model 2 - t-distribution

portfolio_sims_t= np.full(shape=(num_days, mc_sims), fill_value=0.0) #num_days (rows) * mc_sims (cols), starts blank, each row is a day, each column is a simulation
df=8 #can be modified

for m in range(0, mc_sims): #for each simulation
    #cholesky decomposition to determine lower triangular matrix of covariance matrix, simple for monte carlo simulation, allows for correlated random variables
    z = np.random.normal(size=(num_days, len(mean_returns))) #generates matrix of normally distributed random numbers, num_days rows * 4 cols (days * stocks)
    u = rng.chisquare(df, size=num_days).reshape(num_days, 1) #chi-squared numbers , list of 1 per simulation (using NumPy rng)
    l = np.linalg.cholesky(cov_matrix * (df - 2) / df) #cholesky decomposition of covariance matrix (lower triangle matrix), size = #stocks * #stocks
    #variance of x is df/(df-2)
    x = z / np.sqrt(u / df)
    daily_returns = mean_m + l @ x.T #stocks x days, existing mean returns + triangle matrix*random numbers
    #inner (sum product) requires number of cols to match (no transpose like regular matrix multiplication), leading to #rowsA * #rowsB for dimensions
    #covar matrix values are randomly distributed in magnitude (relative to mean return)
    portfolio_sims_t[:, m] = np.cumprod(daily_returns.T @ weights + 1) * initial_portfolio #


## Model 3 - Random Days
portfolio_hist= np.full(shape=(num_days, mc_sims), fill_value=0.0)

for m in range(0,mc_sims):
    sampled_returns = returns.sample(n=num_days,replace=True) #randomly selects n days in a random order
    portfolio_hist[:, m] = np.cumprod(sampled_returns @ weights + 1) * initial_portfolio #gives portfolio value each day by multiplying each day's returns by their weights


