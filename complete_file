# Monte Carlo Simulation - Portfolio Risk Analysis
#
# This script demonstrates three Monte Carlo return models, then evaluates
# VaR / CVaR and backtests the VaR forecasts against historical data.

# ----------------------------
# Imports
# ----------------------------
import datetime as dt

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import yfinance as yf
from numpy.random import default_rng
from scipy.optimize import minimize

# ----------------------------
# Configuration and constants
# ----------------------------
stocks = ['AAPL', 'MSFT', 'GOOG', 'AMZN']
weights = [0.25, 0.25, 0.25, 0.25]

end_date = dt.datetime.now()
start_date = end_date - dt.timedelta(days=300)

initial_portfolio = 1000
mc_sims = 500
num_days = 50
alpha = 5

rng = default_rng()

# ----------------------------
# Data Collection
# ----------------------------
def get_data(stocks, start, end, trade_days=200):
    """Download stock data, compute daily returns, and summarize risk."""
    stock_data = yf.download(stocks, start=start, end=end, auto_adjust=False)

    if isinstance(stock_data.columns, pd.MultiIndex):
        stock_data = stock_data['Close']
    else:
        if 'Close' in stock_data.columns:
            stock_data = stock_data[['Close']]
        else:
            raise ValueError("The downloaded data does not contain a 'Close' column.")

    returns = stock_data.pct_change().tail(trade_days)
    mean_returns = returns.mean()
    cov_matrix = returns.cov()
    return mean_returns, cov_matrix, returns


mean_returns, cov_matrix, returns = get_data(stocks, start_date, end_date)

# ----------------------------
# Portfolio simulation setup
# ----------------------------
# Create a numeric matrix of mean returns with shape (n_stocks, num_days)
mean_values = np.asarray(mean_returns)
mean_m = np.tile(mean_values.reshape(-1, 1), (1, num_days))

# ----------------------------
# Model 1: Multivariate normal distribution
# ----------------------------
portfolio_sims = np.full(shape=(num_days, mc_sims), fill_value=0.0)

for m in range(mc_sims):
    z = np.random.normal(size=(num_days, len(mean_returns)))
    l = np.linalg.cholesky(cov_matrix)
    daily_returns = mean_m + l @ z.T
    portfolio_sims[:, m] = np.cumprod(daily_returns.T @ weights + 1) * initial_portfolio

# ----------------------------
# Model 2: Student-t distribution
# ----------------------------
portfolio_sims_t = np.full(shape=(num_days, mc_sims), fill_value=0.0)
df = 8

for m in range(mc_sims):
    z = np.random.normal(size=(num_days, len(mean_returns)))
    u = rng.chisquare(df, size=num_days).reshape(num_days, 1)
    l = np.linalg.cholesky(cov_matrix * (df - 2) / df)
    x = z / np.sqrt(u / df)
    daily_returns = mean_m + l @ x.T
    portfolio_sims_t[:, m] = np.cumprod(daily_returns.T @ weights + 1) * initial_portfolio

# ----------------------------
# Model 3: Random historical days
# ----------------------------
portfolio_hist = np.full(shape=(num_days, mc_sims), fill_value=0.0)

for m in range(mc_sims):
    sampled_returns = returns.sample(n=num_days, replace=True)
    portfolio_hist[:, m] = np.cumprod(sampled_returns @ weights + 1) * initial_portfolio

# ----------------------------
# Benchmark: historic returns
# ----------------------------
historic = returns.tail(num_days)
portfolio_returns = historic @ weights
portfolio_indiv = initial_portfolio * np.cumprod(portfolio_returns + 1)

# ----------------------------
# Risk metrics
# ----------------------------
def mcValueRisk(returns, alpha=5):
    """Input: pandas Series of returns. Output: percentile on return distribution."""
    if isinstance(returns, pd.Series):
        return np.percentile(returns, alpha)
    else:
        raise TypeError("Expected pandas data series")


def mcConditionalValueRisk(returns, alpha=5):
    """Input: pandas Series of returns. Output: CVaR at alpha confidence."""
    if isinstance(returns, pd.Series):
        below_var = returns <= mcValueRisk(returns, alpha=alpha)
        return returns[below_var].mean()
    else:
        raise TypeError("Expected pandas data series")


# Combine final portfolio values from each model into a single DataFrame
results_df = pd.DataFrame({
    'normal': portfolio_sims[-1, :],
    't': portfolio_sims_t[-1, :],
    'hist': portfolio_hist[-1, :]
})

# Compute VaR and CVaR for each column (model) and combine into a summary DataFrame
VaR = results_df.apply(lambda col: initial_portfolio - mcValueRisk(col, alpha=alpha))
CondVaR = results_df.apply(lambda col: initial_portfolio - mcConditionalValueRisk(col, alpha=alpha))

risk_summary = pd.DataFrame({
    'VaR': VaR,
    'CVaR': CondVaR
})

# ----------------------------
# Historical backtesting for VaR forecasts
# ----------------------------
# Download approximately 5 years of daily adjusted prices
end_date_past_data = pd.Timestamp.today().normalize()
start_date_past_data = end_date_past_data - pd.DateOffset(years=5)

prices_past_data = yf.download(
    stocks,
    start=start_date_past_data,
    end=end_date_past_data,
    auto_adjust=True,
    progress=False
)['Close']

returns_past_data = prices_past_data.pct_change().dropna()
portfolio_returns_past_data = returns_past_data @ weights

# Backtesting settings
window_backtest = 250
alpha_backtest = 0.05
num_sims_backtest = 10000
df_backtest = 8
rng = np.random.default_rng(10)

backtest_data = pd.DataFrame(
    index=portfolio_returns_past_data.index[window_backtest:],
    columns=['Normal', 'Student-t', 'Historical'],
    dtype=float,
)
backtest_data['Actual Return'] = portfolio_returns_past_data.iloc[window_backtest:].to_numpy()

for i in range(window_backtest, len(portfolio_returns_past_data)):
    historical_window = returns_past_data.iloc[i - window_backtest:i]
    mu = historical_window.mean().to_numpy()
    cov = historical_window.cov().to_numpy()
    historical_portfolio = historical_window @ weights
    L = np.linalg.cholesky(cov)

    # Model 1: Multivariate Normal
    z_normal = rng.standard_normal(size=(num_sims_backtest, len(stocks)))
    simulated_normal = mu + z_normal @ L.T
    portfolio_normal = simulated_normal @ weights
    backtest_data.iloc[i - window_backtest, 0] = np.quantile(portfolio_normal, alpha_backtest)

    # Model 2: Multivariate Student-t
    L_t = np.linalg.cholesky(cov * (df_backtest - 2) / df_backtest)
    z_t = rng.standard_normal(size=(num_sims_backtest, len(stocks))) @ L_t.T
    u = rng.chisquare(df_backtest, size=num_sims_backtest)
    simulated_t = mu + z_t / np.sqrt(u / df_backtest)[:, None]
    portfolio_t = simulated_t @ weights
    backtest_data.iloc[i - window_backtest, 1] = np.quantile(portfolio_t, alpha_backtest)

    # Model 3: Historical Simulation
    backtest_data.iloc[i - window_backtest, 2] = np.quantile(historical_portfolio, alpha_backtest)

# Count VaR violations
for model in ['Normal', 'Student-t', 'Historical']:
    backtest_data[f'{model} Violation (T/F)'] = (backtest_data['Actual Return'] < backtest_data[model])

violation_rates = backtest_data.iloc[:, 4:7].mean().mul(100)

summary = pd.DataFrame({
    'Model': ['Normal', 'Student-t', 'Historical'],
    'Expected Violations (%)': [5.0, 5.0, 5.0],
    'Actual Violations (%)': violation_rates.values
})

# ----------------------------
# Plotting
# ----------------------------
# Portfolio simulation comparison
fig, axes = plt.subplots(1, 3, figsize=(15, 5), sharey=True)

axes[0].plot(portfolio_sims)
axes[0].set_title('Monte Carlo Simulation')
axes[0].set_xlabel('Days')
axes[0].set_ylabel('Portfolio Value ($)')

axes[1].plot(portfolio_sims_t)
axes[1].set_title('t-distribution Simulation')
axes[1].set_xlabel('Days')

axes[2].plot(portfolio_hist)
axes[2].set_title('Random Days')
axes[2].set_xlabel('Days')

plt.tight_layout()

# VaR backtesting summary
summary.plot(
    x='Model',
    y=['Expected Violations (%)', 'Actual Violations (%)'],
    kind='bar',
    figsize=(9, 5),
    title='VaR Backtesting: Expected vs. Actual Violation Rates'
)

plt.ylabel('Violation Rate (%)')
plt.xlabel('Model')
plt.xticks(rotation=0)
plt.legend(title='Violation Type')
plt.grid(axis='y')
plt.show()

